    "/api/v1/auth/callback": {
      "get": {
        "operationId": "callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect after successful OAuth"
          },
          "401": {
            "description": "OAuth failed"
          },
          "403": {
            "description": "CSRF state mismatch"
          }
        }
      }
    },
